{
  "id": "opt-team",
  "version": "1.0.0",
  "name": "OPT 六角色",
  "nameEn": "OPT Six Roles",
  "tagline": "一支配置完整的 AI 团队：上情报、下决策、左洞察、右诊断、中枢纽、外交付",
  "description": "不是六个人设，是六套完整工作区——带人格、方法论、每步退出条件、安全边界、技能库、定时任务。共 14 个技能，全部遵循 agentskills.io 开放规范。",
  "author": "ClawOPT",
  "license": "见仓库 LICENSE",
  "params": [
    {
      "key": "USER_TITLE",
      "label": "Agent 怎么称呼你",
      "hint": "会出现在所有对话里。课程设计角色用得最多。",
      "default": "你",
      "examples": [
        "你",
        "老师",
        "老板",
        "Boss"
      ]
    },
    {
      "key": "USER_ROLE",
      "label": "你的身份与所在领域",
      "hint": "写进各角色的 USER.md 画像段，越具体 Agent 越准。",
      "default": "创业者",
      "examples": [
        "创业者",
        "某 SaaS 公司创始人，B 端软件赛道",
        "产品负责人，电商方向"
      ]
    },
    {
      "key": "USER_STRENGTH",
      "label": "你的强项（商业洞察角色用）",
      "hint": "它会据此判断该在哪一层多追问。",
      "default": "较强",
      "examples": [
        "强（有十年产品经验）",
        "一般，正在补"
      ]
    },
    {
      "key": "USER_BLINDSPOT",
      "label": "你已知的思维盲区（商业洞察角色用）",
      "hint": "这条最有价值——直接决定它在哪里拉住你。",
      "default": "容易跳过用户场景直接给方案",
      "examples": [
        "容易从供给端出发",
        "容易过早收敛",
        "容易只看推力忽略阻力"
      ]
    },
    {
      "key": "AGENT_AVATAR",
      "label": "课程设计角色的头像 URL（可留空）",
      "hint": "工作区相对路径、http(s) URL 或 data URI。",
      "default": "avatars/course-design.png"
    }
  ],
  "roles": [
