  "apiFiles": {
    "_comment": "这 6 个可通过 POST /api/sessions 直接写入",
    "identityContent": "IDENTITY.md",
    "soulContent": "SOUL.md",
    "agentsContent": "AGENTS.md",
    "userContent": "USER.md",
    "toolsContent": "TOOLS.md",
    "heartbeatContent": "HEARTBEAT.md"
  },
  "workspaceFiles": {
    "_comment": "API 不支持，装配器直接写入工作区目录",
    "files": [
      "MEMORY.md",
      "BOOTSTRAP.md"
    ],
    "dirs": [
      "skills/",
      "reference/",
      "memory/",
      "avatars/"
    ],
    "scripts": [
      "automations.sh"
    ]
  },
  "postInstall": [
    "打开每个角色的 BOOTSTRAP.md，走一遍七步出生仪式，完成后删除它",
    "在每个工作区跑 bash automations.sh 建定时任务",
    "课程设计角色需按 roles/course-design/skills/EXTERNAL.md 安装 10 个外部技能",
    "跑 shared/validate-skills.sh 校验技能规格"
  ]
